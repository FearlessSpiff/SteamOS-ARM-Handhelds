# SM8750 (Snapdragon 8 Elite, Qualcomm's own ID CQ8725S): AYN Odin 3.
# Sourced by kernel-common/build.sh and kernel-common/cmdline.sh.
#
# First cut at building this kernel from source instead of extracting
# ROCKNIX's prebuilt release (external-and-mods/kernel-sm8750/extract-rocknix.sh).
# The prebuilt kernel has no tracefs (CONFIG_FTRACE is not set in ROCKNIX's
# own defconfig for this device): steamos-manager -r exits EPERM trying to
# create /sys/kernel/tracing, and mangoapp (Performance Overlay) needs it
# for Adreno busy/memory -- see kernel-common/steamos.config, which both
# flags are already enabled in and gets merged in here same as every other
# SoC. Building from source is the only way to get that in.

SOC=sm8750
ROCKNIX_DEVICE=SM8750

# ROCKNIX has no dedicated x.y.0 tarball on kernel.org (only linux-7.2.tar.xz,
# no linux-7.2.0.tar.xz -- kernel.org's own convention for a first release in
# a series), but the booted prebuilt kernel self-reports "7.2.0" (`uname -r`
# on a real Odin 3), which is just linux-7.2.tar.xz's own internal version
# string (SUBLEVEL=0). KVER must stay "7.2" so kernel-common/build.sh's
# kernel.org fetch URL resolves.
KVER=7.2
ROCKNIX_REF=20260901

# ROCKNIX's PKG_PATCH_DIRS equivalent for SM8750 on 7.2: no "default" patch
# dir exists at this ref (unlike SM8550/SM8650), kernel-common/build.sh
# already skips a missing patch dir rather than failing.
PATCH_DIRS="projects/ROCKNIX/packages/linux/patches/7.2 projects/ROCKNIX/packages/linux/patches/mainline projects/ROCKNIX/devices/SM8750/patches/linux"

# projects/ROCKNIX/devices/SM8750/patches/linux/0047-arm64-dts-qcom-Add-AYN-Odin3.patch
# adds this file (and its arch/arm64/boot/dts/qcom/Makefile entry) directly,
# unlike SM8550/SM8650 which need a kernel-<soc>/dts/*.append on top of a
# base file already in tree -- no kernel-sm8750/dts/ needed for this device.
DTBS="cq8725s-ayn-odin3"

# GPU firmware (projects/ROCKNIX/devices/SM8750/config/kernel-firmware.dat):
# gmu/sqe/aqe are in upstream linux-firmware; zap is Adreno-830-specific and
# only in ROCKNIX's own extra-firmware staging repo. REF is extra-firmware's
# HEAD as of this port (2026-10-01) -- not a dated/pinned release like
# SM8550's EXTRA_FW_REF, because none exists yet for this device; re-pin to
# something stabler once ROCKNIX tags one.
EXTRA_FW_REF=e1eb71af80427aa1fec1659d2967f7ba8bef83b5
LINUX_FW_REF=main
# Installed to the rootfs only, loaded once the root is mounted, same as
# every other SoC here -- see kernel-sm8550/soc.env for why (no built-in
# firmware in ROCKNIX's own kernel either).
FW_BUILTIN=0
BUILTIN_FW="
lfw/qcom/gen80000_gmu.bin:qcom/gen80000_gmu.bin
lfw/qcom/gen80000_sqe.fw:qcom/gen80000_sqe.fw
lfw/qcom/gen80000_aqe.fw:qcom/gen80000_aqe.fw
xfw/SM8750/qcom/sm8750/gen80000_zap.mbn:qcom/sm8750/gen80000_zap.mbn
"

# From the live Odin 3's own /proc/cmdline (ROCKNIX's prebuilt kernel,
# boot=/disk= stripped -- our build_cmdline() supplies root= itself):
# "rootwait quiet video=efifb:off console=tty0 irqaffinity=0-1
#  cgroup.memory=nokmem,nosocket nosoftlockup". rootwait/quiet/video=efifb:off
# are already added generically by kernel-common/cmdline.sh.
CMDLINE_SOC="console=tty0 irqaffinity=0-1 cgroup.memory=nokmem,nosocket nosoftlockup"

# ROCKNIX's SM8750/options: KERNEL_TARGET="Image", BOOTLOADER="qcom-abl" --
# same ABL bootimg packing as SM8550/SM8650.
EMBED_INITRAMFS=1
