/*
 * SteamOS ARM additions for the AYN Odin 3 (appended to cq8725s-ayn-odin3.dts
 * by kernel-common/build.sh). s2idle (as ArmadaOS): the codec keeps these
 * rails enabled through the sleep, idle them in LPM.
 */

&vreg_bob1 {
	regulator-state-mem {
		regulator-on-in-suspend;
		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
	};
};

&vreg_l15b_1p8 {
	regulator-state-mem {
		regulator-on-in-suspend;
		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
	};
};

&vreg_l2i_1p2 {
	regulator-state-mem {
		regulator-on-in-suspend;
		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
	};
};

&vreg_s3g_1p8 {
	regulator-state-mem {
		regulator-on-in-suspend;
		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
	};
};

&vreg_s7i_1p2 {
	regulator-state-mem {
		regulator-on-in-suspend;
		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
	};
};

/*
 * DisplayPort audio over USB-C: mdss_dp0 as the codec of a DISPLAY_PORT_RX_0
 * backend. Needs the DISPLAY_PORT_RX_0 graph in SM8750-AYN-tplg.bin
 * (../audio-topology) and the UCM DisplayPort device.
 */
/ {
	sound {
		dp0-dai-link {
			link-name = "DP0 Playback";

			cpu {
				sound-dai = <&q6apmbedai DISPLAY_PORT_RX_0>;
			};

			codec {
				sound-dai = <&mdss_dp0>;
			};

			platform {
				sound-dai = <&q6apm>;
			};
		};
	};
};
